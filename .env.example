# ===========================================
# ChineseRAGKB 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ===========================================

# ---------- 数据库配置 ----------
# SQLite（开发环境，默认）
DB_PATH=data/users.db

# PostgreSQL（生产环境）
# DATABASE_URL=postgresql://user:password@localhost:5432/chineseragkb

# docker-compose 部署所需的数据库口令（compose 会读取并在缺失时报错退出，
# 不再使用写死的 raguser/ragpass）
# POSTGRES_USER=raguser
# POSTGRES_PASSWORD=请填写强随机口令
# POSTGRES_DB=chineseragkb

# PostgreSQL 连接池配置（仅 PostgreSQL 生效）
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true
# DB_ECHO=false

# ---------- JWT 配置 ----------
# JWT 密钥（生产环境务必修改，至少 32 字符随机串）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-key-min-256-bits-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 生产环境设为 1：当 JWT_SECRET 缺失 / 仍是占位符 / 少于 32 字符时直接拒绝启动。
# docker-compose 已默认注入 REQUIRE_STRONG_JWT=1。
# REQUIRE_STRONG_JWT=1

# ---------- 模型后端 ----------
# 决定「模型从哪来」。三个值：local | ollama | openai
# 容器内推荐 ollama / openai —— 都不需要 GPU，也不需要把 torch 打进镜像。
#
#   local  ：本地 transformers 权重（需要 torch，需预先下载模型）
#   ollama ：本机 Ollama 服务（无需 GPU，无需下载权重）← 推荐
#   openai ：任意 OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / 硅基流动 / vLLM…）
#
# LLM 与 Embedding 可分别设置；两者都选 ollama 或 openai 时，完全不需要 torch。
# LLM_BACKEND=ollama
# EMBEDDING_BACKEND=ollama

# ---- Ollama（LLM_BACKEND=ollama 时使用）----
# 准备：ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
# EMBEDDING_OLLAMA_MODEL=nomic-embed-text
# 容器内访问宿主机的 Ollama 要用（容器里的 localhost 是容器自己）：
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ---- OpenAI 兼容（LLM_BACKEND=openai 时使用）----
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# ---- 本地推理（LLM_BACKEND=local 时使用）----
# 注：模型路径不通过环境变量传递，请在 config/config.yaml 的 llm.model_name 配置。
DEVICE=auto
USE_4BIT=false

# LLM 并发限制
LLM_MAX_CONCURRENT=3
LLM_FREE_RATE=2.0
LLM_PRO_RATE=20.0
LLM_ENTERPRISE_RATE=100.0

# ---------- Redis 配置 ----------
# Redis（可选，用于缓存和限流）
# REDIS_URL=redis://localhost:6379/0

# ---------- CORS 配置 ----------
# 允许的源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# ---------- 审计日志 ----------
AUDIT_LOG_FILE=logs/audit.jsonl
AUDIT_USE_DB=true
AUDIT_USE_FILE=true

# ---------- 请求日志 ----------
LOG_SAMPLE_RATE=1.0
LOG_REQUEST_BODY=false
SLOW_REQUEST_THRESHOLD_MS=1000.0

# ---------- 熔断器配置 ----------
# LLM 调用熔断器
CB_LLM_FAILURE_THRESHOLD=5
CB_LLM_TIMEOUT=60

# ---------- 其他 ----------
# HuggingFace 镜像（国内加速）
# HF_ENDPOINT=https://hf-mirror.com

# 路径配置
EMBEDDING_CACHE_DIR=./models/sentence-transformers
LLM_CACHE_DIR=./models/huggingface
