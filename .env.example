# ===========================================
# 知阁 Zhige 环境变量配置示例
# 复制此文件为 .env 并根据需要修改
# ===========================================

# ===========================================
# 【开箱即用推荐配置】
# 
# 方式一：使用 Ollama（推荐，无需 GPU）
#   1. 下载 Ollama: https://ollama.com/download
#   2. 运行: ollama pull qwen2.5:7b
#   3. 运行: ollama pull nomic-embed-text
#   4. 无需修改本文件，直接运行 python scripts\quickstart.py
#
# 方式二：使用云端 API
#   取消下面 OPENAI_API_KEY 的注释并填入你的 API Key
# ===========================================

# ---------- 数据库配置 ----------
# SQLite（开发环境/默认）
DB_PATH=data/users.db

# PostgreSQL（生产环境，可选）
# DATABASE_URL=postgresql://user:password@localhost:5432/chineseragkb

# ---------- JWT 配置 ----------
# JWT 密钥（生产环境建议修改）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-secret-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- 模型后端 ----------
# 
# 三种后端可选：
#   ollama  - 使用本机 Ollama（推荐，无需 GPU）← 默认
#   openai  - 使用 OpenAI 兼容 API
#   local   - 使用本地 HuggingFace 模型（需要 torch）
#
# 推荐使用 Ollama，不需要 GPU，不需要下载权重

# 对话模型后端
LLM_BACKEND=ollama

# 向量模型后端
EMBEDDING_BACKEND=ollama

# ---- Ollama 配置（LLM_BACKEND=ollama 时使用）----
# 准备：ollama pull qwen2.5:7b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_OLLAMA_MODEL=nomic-embed-text

# ---- OpenAI 兼容配置（LLM_BACKEND=openai 时使用）----
# 取消下面的注释并填入你的 API Key
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# ---- 本地模型配置（LLM_BACKEND=local 时使用）----
# 需要安装 torch 和下载模型权重
# DEVICE=auto

# ---------- CORS 配置 ----------
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# ---------- 其他 ----------
# HuggingFace 镜像（国内加速）
# HF_ENDPOINT=https://hf-mirror.com
