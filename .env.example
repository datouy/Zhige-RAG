# ===========================================
# ChineseRAGKB 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ===========================================

# ---------- 数据库配置 ----------
# SQLite（开发环境，默认）
DB_PATH=data/users.db

# PostgreSQL（生产环境）
# DATABASE_URL=postgresql://user:password@localhost:5432/chineseragkb

# PostgreSQL 连接池配置（仅 PostgreSQL 生效）
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true
# DB_ECHO=false

# ---------- JWT 配置 ----------
# JWT 密钥（生产环境务必修改，至少 32 字符）
JWT_SECRET=your-super-secret-key-min-256-bits-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- LLM 配置 ----------
# OpenAI API（可选，使用云端模型）
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# 本地模型配置
LLM_MODEL_PATH=./models/Qwen2.5-1.5B-Instruct
DEVICE=auto
USE_4BIT=false

# LLM 并发限制
LLM_MAX_CONCURRENT=3
LLM_FREE_RATE=2.0
LLM_PRO_RATE=20.0
LLM_ENTERPRISE_RATE=100.0

# ---------- Redis 配置 ----------
# Redis（可选，用于缓存和限流）
# REDIS_URL=redis://localhost:6379/0

# ---------- CORS 配置 ----------
# 允许的源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# ---------- 审计日志 ----------
AUDIT_LOG_FILE=logs/audit.jsonl
AUDIT_USE_DB=true
AUDIT_USE_FILE=true

# ---------- 请求日志 ----------
LOG_SAMPLE_RATE=1.0
LOG_REQUEST_BODY=false
SLOW_REQUEST_THRESHOLD_MS=1000.0

# ---------- 熔断器配置 ----------
# LLM 调用熔断器
CB_LLM_FAILURE_THRESHOLD=5
CB_LLM_TIMEOUT=60

# ---------- 其他 ----------
# HuggingFace 镜像（国内加速）
# HF_ENDPOINT=https://hf-mirror.com

# 路径配置
EMBEDDING_CACHE_DIR=./models/sentence-transformers
LLM_CACHE_DIR=./models/huggingface
