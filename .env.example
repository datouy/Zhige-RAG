# ===========================================
# 知阁 Zhige 环境变量配置示例
# 复制此文件为 .env 并根据需要修改
# ===========================================

# ===========================================
# 【开箱即用推荐配置】
# 
# 方式一：使用 Ollama（推荐，无需 GPU）
#   1. 下载 Ollama: https://ollama.com/download
#   2. 运行: ollama pull qwen3:4b-instruct-2507-q4_K_M
#   3. 运行: ollama pull nomic-embed-text
#   4. 无需修改本文件，直接运行 python scripts\quickstart.py
#
# 方式二：使用云端 API
#   取消下面 OPENAI_API_KEY 的注释并填入你的 API Key
# ===========================================

# ---------- 数据库配置 ----------
# SQLite（开发环境/默认）
DB_PATH=data/users.db

# PostgreSQL（生产环境，可选）
# DATABASE_URL=postgresql://user:password@localhost:5432/chineseragkb

# ---------- 模型后端 ----------
# 
# 无 LLM 模式默认直接返回知识库原文 + 引用；向量模型使用 CPU ONNX。
# 如需生成式回答，可再选择 local / ollama / openai（均为可选）。

# 对话模型后端
LLM_BACKEND=extractive

# 向量模型后端
EMBEDDING_BACKEND=onnx

# ---- Ollama 配置（可选）----
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# EMBEDDING_OLLAMA_MODEL=nomic-embed-text

# ---- OpenAI 兼容配置（LLM_BACKEND=openai 时使用）----
# 取消下面的注释并填入你的 API Key
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# ---- 本机生成模型配置（可选）----
# LLM_BACKEND=local
# LLM_MODEL_PATH=./models/your-model
# DEVICE=auto

# ---------- CORS 配置 ----------
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# ---------- 其他 ----------
# 启动期预热 ONNX Embedding 与向量库。设为 0 可关闭。
RAG_WARMUP=1
# 仅在切回生成式后端时才有意义；extractive 模式始终为 0。
RAG_PRELOAD_LLM=0

# HuggingFace 镜像（国内加速）
# HF_ENDPOINT=https://hf-mirror.com
