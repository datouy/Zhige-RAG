# ============================================================
# ChineseRAGKB Dockerfile.lite —— 无 LLM 轻量部署（不安装 torch）
# ============================================================
# 与 Dockerfile（全量）的唯一区别：**不安装 requirements-local.txt**。
# 也就是不打进 torch（2~3 GB），镜像体积从 ~10 GB 降到 ~1 GB 量级。
#
# 适用场景：
#   - 默认 extractive 回答 + 本地 ONNX CPU 向量
#   - 需要生成式回答时再显式覆盖 LLM_BACKEND
#
# 需要完全离线本地推理时，请改用全量 Dockerfile。
#
# 启动示例：
#   docker build -f Dockerfile.lite -t chineseragkb:lite .
#   docker run -p 8000:8000 chineseragkb:lite
# ============================================================

# ---- Stage 1: Builder ----
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 只装核心 + 可选能力依赖，不含 torch
COPY requirements-core.txt requirements-optional.txt ./
RUN pip install --no-cache-dir --user -r requirements-core.txt -r requirements-optional.txt

# ---- Stage 2: Runtime ----
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash appuser

COPY --from=builder /root/.local /home/appuser/.local
COPY --chown=appuser:appuser . .

RUN python scripts/setup_onnx_embedding.py

RUN mkdir -p /app/data/chroma /app/logs /app/data/raw \
    && chown -R appuser:appuser /app

USER appuser

# 默认不加载生成式模型；用云端 API 时可显式覆盖。
ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LLM_BACKEND=extractive \
    EMBEDDING_BACKEND=onnx \
    HF_ENDPOINT=https://hf-mirror.com

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
